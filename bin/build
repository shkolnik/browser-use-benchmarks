#!/usr/bin/env python3
import sys
from pathlib import Path

# Line-buffer our own stdout. Python block-buffers it whenever it is not a
# tty, which in CI it never is, while every child process we spawn writes to
# the same fd immediately. The result is that our output and the children's
# arrive in the log in the wrong order: `run`'s `+ docker build ...` echoes,
# and the smoke path's diagnostic headers, all sat in the buffer until exit
# while the commands' output streamed past. On the gitlab smoke failures that
# printed a block of bare headers with nothing under them (#76) — the evidence
# was not missing, it was somewhere else in the log.
sys.stdout.reconfigure(line_buffering=True)
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from builder.cli import main
sys.exit(main())
